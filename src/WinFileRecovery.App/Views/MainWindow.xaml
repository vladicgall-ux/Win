<Window x:Class="WinFileRecovery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinFileRecovery.App.ViewModels"
        Title="Восстановление файлов" Height="620" Width="960" MinWidth="720" MinHeight="480">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drive / mode selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Диск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="360" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Margin="0,0,16,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Model}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Обновить список" Command="{Binding RefreshDrivesCommand}" Padding="8,2" Margin="0,0,16,0"/>

            <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="300" ItemsSource="{Binding ScanModes}" SelectedItem="{Binding SelectedScanMode}"/>
        </StackPanel>

        <!-- Actions + progress -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Начать сканирование" Command="{Binding ScanCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Отменить" Command="{Binding CancelScanCommand}" Padding="10,4" Margin="0,0,16,0"/>
            <ProgressBar Width="300" Height="20" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Results -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}"
                  SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="ResultsGrid_SelectionChanged" x:Name="ResultsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="260"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Extension}" Width="60"/>
                <DataGridTextColumn Header="Размер (байт)" Binding="{Binding LengthBytes}" Width="120"/>
                <DataGridTextColumn Header="Смещение" Binding="{Binding StartOffsetBytes}" Width="120"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Recover -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Восстановить выбранные..." Command="{Binding RecoverSelectedCommand}" Padding="10,4"/>
            <TextBlock Text="Совет: восстанавливайте на другой физический диск, чтобы не перезаписать искомые файлы."
                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
