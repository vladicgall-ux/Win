<Window x:Class="WinFileRecovery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinFileRecovery.App.ViewModels"
        xmlns:conv="clr-namespace:WinFileRecovery.App.Converters"
        Title="Восстановление файлов" Height="700" Width="1000" MinWidth="760" MinHeight="560"
        FontSize="14" Background="#F3F3F3">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BytesToReadableConverter x:Key="Bytes"/>
        <conv:IntEqualsConverter x:Key="IntEquals"/>
        <conv:NullableUtcToLocalStringConverter x:Key="UtcToLocal"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B9B9B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#C6C6C6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Восстановление удалённых файлов" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Найдите и верните файлы, удалённые с жёсткого диска или флешки — в три простых шага."
                       Foreground="#555" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                 Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Остановить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Step 1: drive -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Шаг 1. Выберите диск" Style="{StaticResource StepTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Обновить список"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDrivesCommand}"/>
                            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                                      Margin="0,0,10,0" Padding="8,6" MinWidth="300" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Model}"/>
                                            <TextBlock Text=" — " />
                                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource Bytes}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: mode + start -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Шаг 2. Начните поиск удалённых файлов" Style="{StaticResource StepTitle}"/>

                        <RadioButton GroupName="ScanMode" Margin="0,0,0,8"
                                     IsChecked="{Binding ScanModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                            <StackPanel>
                                <TextBlock Text="Быстрый поиск (рекомендуется)" FontWeight="SemiBold"/>
                                <TextBlock Text="Использует записи файловой системы — быстро и точно восстанавливает имена файлов."
                                           Foreground="#666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="ScanMode"
                                     IsChecked="{Binding ScanModeIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                            <StackPanel>
                                <TextBlock Text="Глубокий поиск" FontWeight="SemiBold"/>
                                <TextBlock Text="Ищет файлы по содержимому во всех секторах диска. Дольше, но помогает, если быстрый поиск ничего не нашёл (например, диск был отформатирован). Имена файлов при этом не восстанавливаются."
                                           Foreground="#666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Background="#F7F7F7" CornerRadius="4" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Искать только файлы, удалённые за период (необязательно):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Margin="0,0,16,0"
                                                IsEnabled="{Binding IsDateFilterUsable}"/>
                                    <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding DateTo}" Width="130" Margin="0,0,16,0"
                                                IsEnabled="{Binding IsDateFilterUsable}"/>
                                    <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ClearDateFilterCommand}"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"
                                           Visibility="{Binding IsDateFilterUsable, Converter={StaticResource BoolToVis}}"
                                           Text="Точная дата удаления в NTFS/FAT32 не хранится — используется примерная дата последнего изменения файла."/>
                                <TextBlock Margin="0,6,0,0" Foreground="#B35A00" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Visibility="{Binding IsDateFilterUsable, Converter={StaticResource InverseBoolToVis}}"
                                           Text="Фильтр по дате недоступен для глубокого поиска — сигнатуры файлов не хранят дату. Переключитесь на быстрый поиск, чтобы искать по периоду."/>

                                <TextBlock Text="Какие типы файлов искать:" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                <ItemsControl ItemsSource="{Binding FileCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Value.Name}" IsChecked="{Binding IsSelected}" Margin="0,0,16,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"
                                           Text="Ничего не отмечено или отмечено всё — значит без ограничения по типу (искать всё)."/>
                            </StackPanel>
                        </Border>

                        <Button Content="Начать поиск" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Step 3: results -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Шаг 3. Выберите файлы и восстановите" Style="{StaticResource StepTitle}"/>

                        <TabControl>
                            <TabItem Header="Найденные файлы">
                                <StackPanel Margin="0,8,0,0">

                                    <CheckBox Content="Выбрать все (из показанных)" IsChecked="{Binding SelectAll}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ScanResultsView}" Height="280"
                                              AutoGenerateColumns="False" IsReadOnly="False"
                                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                            <DataGridTextColumn Header="Имя файла" Binding="{Binding Value.DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="Тип" Binding="{Binding Value.Extension}" Width="70"/>
                                            <DataGridTextColumn Header="Размер" Binding="{Binding Value.LengthBytes, Converter={StaticResource Bytes}}" Width="100"/>
                                            <DataGridTextColumn Header="Примерная дата удаления" Binding="{Binding Value.EstimatedDeletionUtc, Converter={StaticResource UtcToLocal}}" Width="160"/>
                                            <DataGridTextColumn Header="Найдено через" Binding="{Binding Value.Source}" Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Content="Восстановить выбранные файлы..." Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RecoverSelectedCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <TextBlock Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Совет: сохраняйте восстановленные файлы на ДРУГОЙ диск — запись на сканируемый диск может затереть ещё не восстановленные файлы."/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Отчёт о восстановлении">
                                <DataGrid ItemsSource="{Binding RecoveryLog}" Height="280" Margin="0,8,0,0"
                                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding OriginalDisplayName}" Width="220"/>
                                        <DataGridTextColumn Header="Куда сохранён" Binding="{Binding DestinationPath}" Width="*"/>
                                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" Width="90"/>
                                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="220"/>
                                        <DataGridTextColumn Header="Подпись" Binding="{Binding SignatureStatus}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
